# Application environment.
# Used to adapt the application configuration depending on the environment.
# Expected values: development, test, production.
ENVIRONMENT=development

# Django secret key.
# Generate a unique and secure value for each environment.
SECRET_KEY=

# Enable Django debug mode.
# Should be False in production.
DEBUG=

# Sentry DSN used to send application errors to Sentry.
# Leave empty if Sentry is not configured for this environment.
SENTRY_DSN=

# Allowed hosts, separated by commas.
# Example: localhost,127.0.0.1
ALLOWED_HOSTS=

# Database connection URL.
# Leave empty to use the local SQLite database.
# In production, set this variable to the PostgreSQL connection URL.
DATABASE_URL=




